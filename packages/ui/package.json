{
	"name": "@velastack/schema-ui",
	"version": "0.2.1",
	"description": "Svelte 5 components for PocketBase schemas: a table card, a server-rendered diagram, and the editor.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/velastack/schema.git",
		"directory": "packages/ui"
	},
	"homepage": "https://github.com/velastack/schema#readme",
	"bugs": {
		"url": "https://github.com/velastack/schema/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"prepack": "npm run build && publint"
	},
	"files": [
		"dist",
		"app",
		"!dist/**/*.test.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./editor": {
			"types": "./dist/editor.d.ts",
			"svelte": "./dist/editor.js",
			"default": "./dist/editor.js"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@velastack/schema": "^0.2.0",
		"@xyflow/svelte": "^1.7.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"publint": "^0.3.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.1"
	},
	"keywords": [
		"svelte",
		"pocketbase",
		"schema",
		"velastack"
	]
}
