{
	"name": "@velastack/schema",
	"version": "0.1.0",
	"description": "PocketBase schema engine: canonical collection model, id-based diff, lint, two-phase migration ordering, and layout.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/velastack/schema.git",
		"directory": "packages/schema"
	},
	"homepage": "https://github.com/velastack/schema#readme",
	"bugs": {
		"url": "https://github.com/velastack/schema/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepack": "npm run build && publint"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"publint": "^0.3.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	},
	"keywords": [
		"pocketbase",
		"schema",
		"migrations",
		"velastack"
	]
}
