{
	"name": "velastack-schema",
	"private": true,
	"version": "0.0.0",
	"description": "Visual PocketBase schema viewer/editor: the engine (@velastack/schema) and the UI (@velastack/schema-ui).",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"prepare": "npm run build --workspace packages/schema",
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"test": "npm test --workspaces --if-present",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"prettier": "^3.4.2"
	}
}
